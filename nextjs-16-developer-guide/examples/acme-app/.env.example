# Acme App Environment Configuration Template
# DO NOT commit real secrets or credentials to source control.
# Copy this file to .env.local for local development.

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017/acme_dev

# Mandatory Secrets (MUST be generated securely and NEVER given fallback defaults in code)
# Example secret generation command: openssl rand -base64 32
ADMIN_AUTH_SECRET=
